<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_new"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_new_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuperMarketApp">
        <activity
            android:name=".ui.activities.SignUpActivity"
            android:exported="false"
            android:label="@string/sign_up"
            android:theme="@style/Theme.SuperMarketApp"/>
        <activity android:name=".ui.activities.SignInActivity"
            android:exported="false"
            android:label="@string/common_signin_button_text"
            android:theme="@style/Theme.SuperMarketApp"/>
        <activity android:name=".ui.activities.ProfileActivity"
            android:exported="false"
            android:label="@string/user_profile"
            android:theme="@style/Theme.SuperMarketApp"/>
        <activity
            android:name=".ui.activities.WishlistActivity"
            android:exported="false"
            android:label="@string/wishlist"
            android:theme="@style/Theme.SuperMarketApp"/>
        <activity
            android:name=".ui.activities.ShoppingListActivity"
            android:exported="false"
            android:label="@string/shopping_list"
            android:theme="@style/Theme.SuperMarketApp"/>
        <activity
            android:name=".ui.activities.ShoppingHistoryActivity"
            android:exported="false"
            android:label="@string/shopping_history"
            android:theme="@style/Theme.SuperMarketApp"/>
        <activity
            android:name=".ui.activities.ShoppingHistoryDetailsActivity"
            android:exported="false"
            android:label="@string/shopping_history"
            android:theme="@style/Theme.SuperMarketApp"/>
        <activity
            android:name=".ui.activities.CheckoutActivity"
            android:exported="false"
            android:label="@string/checkout"
            android:theme="@style/Theme.SuperMarketApp"/>
        <activity
            android:name=".ui.activities.ProductDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.SuperMarketApp"/>
        <activity
            android:name=".ui.activities.ProductsActivity"
            android:exported="false"
            android:label="@string/title_activity_products"
            android:theme="@style/Theme.SuperMarketApp" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SuperMarketApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>